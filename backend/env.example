# Copy this file to .env for local development (never commit the real .env)

# Required: your Anthropic API key, from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the model used for analysis
CLAUDE_MODEL=claude-sonnet-4-6

# Optional: local dev server settings
PORT=5000
FLASK_DEBUG=true
